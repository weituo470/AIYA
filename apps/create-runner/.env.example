PORT=3334
LOG_LEVEL=info
AIYA_CREATE_RUNNER_STATE_DIR=.state/create-runner
AIYA_CREATE_RUNNER_WORK_DIR=.state/create-runner/workspaces
AIYA_CREATE_REPO_ROOT=../..
AIYA_CREATE_FAST_LANE_ENABLED=true
AIYA_CREATE_FAST_MODEL_BASE_URL=https://api.openai.com/v1
AIYA_CREATE_FAST_MODEL_API_KEY=
AIYA_CREATE_FAST_MODEL=
AIYA_CREATE_FAST_MODEL_TIMEOUT_MS=90000
AIYA_CREATE_FAST_MODEL_MAX_TOKENS=8192
AIYA_CREATE_FAST_MODEL_TEMPERATURE=0.15
AIYA_CREATE_FAST_MODEL_ATTEMPTS=2
# Optional CLI fallback. Run only in an isolated low-privilege environment.
AIYA_CREATE_CODEX_FALLBACK_ON_FAST_LANE_FAIL=false
AIYA_CREATE_CODEX_MODE=auto
AIYA_CREATE_CODEX_COMMAND=codex
AIYA_CREATE_CODEX_ARGS=exec --skip-git-repo-check --ephemeral --color never -
AIYA_CREATE_JOB_TIMEOUT_MS=180000
AIYA_CREATE_REPAIR_ATTEMPTS=1
