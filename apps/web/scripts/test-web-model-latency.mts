import assert from 'node:assert/strict';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { randomUUID } from 'node:crypto';
import { unlink } from 'node:fs/promises';
import { GET, POST } from '../src/app/api/create-theatre/model-selection/route';
import { shouldUseHermesResponsesApi, hermesReasoningEffort } from '../src/app/api/create-theatre/_hermes-model-health';
import { writeCreateTheatreAdminSettings } from '../src/app/api/create-theatre/_admin-settings';
process.env.CREATE_THEATRE_SETTINGS_FILE=join(tmpdir(),randomUUID()+'.json');
process.env.AIYA_MODEL_LATENCY_FILE=join(tmpdir(),randomUUID()+'.json');
process.env.CREATE_THEATRE_MODEL_OPERATION_PASSWORD='test-pass';
process.env.AIYA_TEACHER_CODER_MODEL='old-model';
process.env.AIYA_TEACHER_CODER_BASE_URL='https://example.invalid/v1';
process.env.AIYA_TEACHER_CODER_API_KEY='test-key';
process.env.CREATE_THEATRE_SETTINGS_ENCRYPTION_KEY='latency-test-only';
await writeCreateTheatreAdminSettings({hermesProfiles:{fusion:{baseUrl:'https://fusion.example.invalid/v1',model:'fusion-max-2.0',apiKey:'fusion-test-only'}}});
assert(shouldUseHermesResponsesApi('gpt-6-astra'));assert.equal(hermesReasoningEffort('gpt-6-astra'),'high');
const originalFetch=globalThis.fetch;let count=0;const bodies:any[]=[];
globalThis.fetch=async (url,init)=>{count++;const body=JSON.parse(String(init?.body));bodies.push(body);
 if(String(url).endsWith('/responses'))return new Response('<h1>SSL failure</h1>',{status:525});
 return Response.json({model:body.model,choices:[{message:{content:'AIYA_OK'}}]});
};
const request=(body:any)=>new Request('https://aiya.test/api/create-theatre/model-selection',{method:'POST',headers:{origin:'https://aiya.test','x-real-ip':randomUUID()},body:JSON.stringify(body)});
try{
 const before=await(await GET(new Request('https://aiya.test'))).json();
 assert.deepEqual(before.options.map((x:any)=>x.model),['deepseek-flash','gpt-6-astra','fusion-max-2.0']);assert.equal(count,0);
 assert.equal((await POST(request({password:'test-pass',mode:'fast'}))).status,400);
 assert.equal((await POST(request({password:'wrong',action:'test'}))).status,403);assert.equal(count,0);
 const responses=await Promise.all([POST(request({password:'test-pass',action:'test'})),POST(request({password:'test-pass',action:'test'}))]);
 assert(responses.every(r=>r.ok));assert.equal(count,3,'Concurrent tests must share paid calls');
 const result=await(await GET(new Request('https://aiya.test'))).json();
 assert.equal(result.options.length,3);assert(result.options[0].latency.available);assert.equal(result.options[1].latency.available,false);assert.equal(result.options[1].latency.status,525);assert(result.options[2].latency.available);
 assert(!JSON.stringify(result).includes('<h1>'));assert(!JSON.stringify(result).includes('test-key'));
 assert(!JSON.stringify(result).includes('fusion-test-only'));
 await POST(request({password:'test-pass',action:'test'}));assert.equal(count,3,'5-minute cache prevents repeated inference');
 const gpt=bodies.find(x=>x.model==='gpt-6-astra');
 assert.equal(gpt.reasoning.effort,'high');assert.equal(gpt.store,false);assert.equal(gpt.stream,false);assert(Array.isArray(gpt.input));
 const fusion=bodies.find(x=>x.model==='fusion-max-2.0');assert.equal(fusion.thinking,undefined);assert.equal(fusion.reasoning_effort,'low');assert.equal(fusion.max_tokens,1024);
 console.log('PASS: three exact model IDs; GPT6 Responses + high; Fusion Chat + low-cost probe; authenticated probes; no GET inference; concurrent deduplication; five-minute cache; no secret/error-body leak');
}finally{globalThis.fetch=originalFetch;await unlink(process.env.AIYA_MODEL_LATENCY_FILE!).catch(()=>{});}
