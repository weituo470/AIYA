import assert from 'node:assert/strict';
import { mkdirSync, writeFileSync } from 'node:fs';
import { assessBuildRequest, smartCandidateTimeout, generationCircuitOpen, recordGenerationHealth } from '../src/app/api/create-theatre/_build-routing-policy';
import { createBuildExecution, chooseBuildModelMode } from '../src/app/api/create-theatre/_build-execution';
import { canRecoverTask, recoveryHash } from '../src/app/api/create-theatre/_task-recovery';
import { recoverableGeneration } from '../src/app/_shared/recoverable-generation';
const results: any[] = [];
const check = async (name: string, fn: () => unknown) => { await fn(); results.push({name,passed:true}); console.log('PASS',name); };
for(const idea of ['做一个两页任务板','做二个页面的工具','做多页面任务板','做2个页面','two pages']) await check('equivalent pages: '+idea,()=>assert(assessBuildRequest(idea).signals.includes('multiple-pages')));
for(const idea of ['倾斜手机移动小球','摇一摇游戏','用语音输入','用前置相机自拍']) await check('device synonym: '+idea,()=>assert(assessBuildRequest(idea).signals.includes('device-media')));
await check('three-level game difficulty',()=>assert(assessBuildRequest('做三关闯关游戏，有敌人、金币、生命和胜利失败').signals.includes('complex-game')));
await check('negated capabilities do not route quality',()=>assert.equal(assessBuildRequest('做计数器，不要摄像头，不需要服务器，不用多页面').complexity,'standard'));
await check('title is not capability',()=>assert.equal(assessBuildRequest('做海报，标题为“数据库”').complexity,'standard'));
await check('local database is not remote backend',()=>assert(!assessBuildRequest('本地数据库').signals.includes('server-data')));
await check('bug repair considers revision context',()=>{assert(!assessBuildRequest('按钮不能使用').signals.includes('complex-revision'));assert(assessBuildRequest('按钮不能使用',true).signals.includes('complex-revision'));});
await check('actual backend is rejected, explicit simulation allowed',()=>{assert.equal(assessBuildRequest('接入真正服务器并跨设备同步').capability,'unsupported-backend');assert.equal(assessBuildRequest('只做模拟原型，模拟数据库登录').capability,'single-html');});
await check('manual model wins; preferences still independent',()=>{const b=createBuildExecution({idea:'两个页面',taskId:'unit',preference:'auto',startedAt:Date.now()});assert.equal(chooseBuildModelMode(b,'default'),'quality');assert.equal(chooseBuildModelMode(b,'default','default'),'default');});
await check('auto budget bounded; quality/manual unchanged',()=>{assert.equal(smartCandidateTimeout('quality',240000,true),90000);assert.equal(smartCandidateTimeout('default',240000,true),120000);assert.equal(smartCandidateTimeout('quality',240000,false),240000);});
await check('two real failures open circuit; no loop; expires',()=>{recordGenerationHealth('unit-fp','transport-failure',1000);assert(!generationCircuitOpen('unit-fp',2000));recordGenerationHealth('unit-fp','transport-failure',2000);assert(generationCircuitOpen('unit-fp',3000));assert(!generationCircuitOpen('unit-fp',302001));});
await check('semantic failure not outage; success resets; credentials changed new fingerprint',()=>{recordGenerationHealth('semantic','semantic-failure',1000);assert(!generationCircuitOpen('semantic',2000));recordGenerationHealth('ok','transport-failure',1000);recordGenerationHealth('ok','transport-failure',2000);assert(generationCircuitOpen('ok',3000));assert(!generationCircuitOpen('new-key',3000));recordGenerationHealth('ok','success',3001);assert(!generationCircuitOpen('ok',4000));});
const token='a'.repeat(64),task={clientTaskId:'unit-task',source:'web-v2',request:{taskContext:{recoveryTokenHash:recoveryHash(token)}}};
await check('web recovery requires high-entropy token and task id, not device id',()=>{assert(canRecoverTask(task,'unit-task','',token));assert(!canRecoverTask(task,'wrong','',token));assert(!canRecoverTask(task,'unit-task','known-device','b'.repeat(64)));assert(!canRecoverTask(task,'unit-task','known-device',''));});
await check('android identity remains separate',()=>{const a={clientTaskId:'a',source:'android-v3',deviceId:'d'};assert(canRecoverTask(a,'a','d',''));assert(!canRecoverTask(a,'a','x',token));});
const body={idea:'test',taskContext:{clientTaskId:'unit-task',recoveryToken:token}};
await check('lost POST recovers same result with ONE POST',async()=>{let now=0,posts=0,gets=0,progress=0;const p=await recoverableGeneration(body,{now:()=>now,wait:async ms=>{now+=ms},fetcher:async(url,init)=>{if(init?.method==='POST'){posts++;throw Error('fetch failed');}gets++;assert.equal((init?.headers as any)['X-Aiya-Recovery'],token);return Response.json(gets===1?{ok:true,pending:true,stage:'calling_model'}:{ok:true,recovered:true,result:{html:'done'}},{status:gets===1?202:200});},onProgress:()=>{progress++}});assert.equal(p.result.html,'done');assert.equal(posts,1);assert.equal(gets,2);assert.equal(progress,1);});
await check('proxy 502/404 while accepting recovers without duplicate generation',async()=>{let now=0,n=0;const p=await recoverableGeneration(body,{now:()=>now,wait:async ms=>{now+=ms},fetcher:async(_u,init)=>{if(init?.method==='POST')return new Response('proxy failure',{status:502});n++;return Response.json(n===1?{ok:false}:{ok:true,result:{html:'done'}},{status:n===1?404:200});}});assert.equal(p.result.html,'done');assert.equal(n,2);});
await check('definite failed task preserves trace and stops polling',async()=>{let calls=0;await assert.rejects(()=>recoverableGeneration(body,{fetcher:async()=>{calls++;return Response.json({ok:false,error:'failed',diagnosticId:'id',build:{status:'failed'}},{status:502});}}),/failed/);assert.equal(calls,1);});
await check('recovery failure is finite, never reposted',async()=>{let now=0,posts=0,gets=0;await assert.rejects(()=>recoverableGeneration(body,{totalMs:5000,pollMs:1000,now:()=>now,wait:async ms=>{now+=ms},fetcher:async(_u,init)=>{if(init?.method==='POST'){posts++;throw Error('connection lost');}gets++;return Response.json({ok:false},{status:404});}}),/等待上限/);assert.equal(posts,1);assert.equal(gets,5);});
mkdirSync('../../outputs/smart-routing-fix',{recursive:true});writeFileSync('../../outputs/smart-routing-fix/unit-results.json',JSON.stringify({passed:true,count:results.length,results},null,2));
console.log('SUMMARY',results.length);
