import assert from 'node:assert/strict';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { randomUUID } from 'node:crypto';
import { encodeModelSelection, readModelSelection, validModelPassword, modelSelectionCookie } from '../src/app/api/create-theatre/_model-selection';
import { GET, POST } from '../src/app/api/create-theatre/model-selection/route';
process.env.CREATE_THEATRE_SETTINGS_ENCRYPTION_KEY='test-only-signing-key';
process.env.CREATE_THEATRE_MODEL_OPERATION_PASSWORD='test-only-pass';
process.env.CREATE_THEATRE_SETTINGS_FILE=join(tmpdir(), `aiya-model-selection-test-${randomUUID()}.json`);
process.env.AIYA_TEACHER_CODER_MODEL='test-model';
process.env.AIYA_TEACHER_CODER_BASE_URL='https://example.invalid/v1';
process.env.AIYA_TEACHER_CODER_API_KEY='test-only-api-key';
const cookie=(token:string)=>new Request('https://aiya.test',{headers:{cookie:`${modelSelectionCookie}=${token}`}});
assert(validModelPassword('test-only-pass')); assert(!validModelPassword('wrong'));
delete process.env.CREATE_THEATRE_MODEL_OPERATION_PASSWORD;
assert(!validModelPassword('test-only-pass'));
assert(!validModelPassword(''));
process.env.CREATE_THEATRE_MODEL_OPERATION_PASSWORD='test-only-pass';
const token=encodeModelSelection('quality');
assert.equal(readModelSelection(cookie(token)),'quality');
assert.equal(readModelSelection(cookie(token.replace('quality','fast'))),undefined);
assert.equal(readModelSelection(cookie(encodeModelSelection('quality',0))),undefined);
assert.equal(readModelSelection(cookie(token+'.extra')),undefined);
assert.equal(readModelSelection(cookie('garbage')),undefined);
let n=0;
const request=(body:any,origin='https://aiya.test')=>new Request('https://aiya.test/api/create-theatre/model-selection',{method:'POST',headers:{'Content-Type':'application/json',origin,'x-forwarded-for':`test-${n++}`},body:JSON.stringify(body)});
assert.equal((await POST(request({password:'wrong',mode:'default'}))).status,403);
assert.equal((await POST(request({password:'test-only-pass',mode:'default'},'https://evil.test'))).status,403);
assert.equal((await POST(request({password:'test-only-pass',mode:'bogus'}))).status,400);
const result=await POST(request({password:'test-only-pass',mode:'default'}));
assert.equal(result.status,200);
const header=result.headers.get('set-cookie')!;
assert(header.includes('HttpOnly')); assert(header.includes('Secure')); assert(header.includes('SameSite=lax'));
assert(!header.includes('test-only-pass'));
const proxyResponse=await POST(new Request('http://localhost:3333/api/create-theatre/model-selection',{method:'POST',headers:{host:'aiya.test','x-forwarded-proto':'https',origin:'https://aiya.test','x-real-ip':'proxy-test'},body:JSON.stringify({password:'test-only-pass',mode:'default'})}));
assert.equal(proxyResponse.status,200); assert(proxyResponse.headers.get('set-cookie')?.includes('Secure'));
const info=await GET(new Request('https://aiya.test',{headers:{cookie:header.split(';')[0]}}));
const text=await info.text(); assert(!text.includes('test-only-api-key')); assert.equal(JSON.parse(text).mode,'default');
for(let i=0;i<8;i++) await POST(new Request('https://aiya.test/api/create-theatre/model-selection',{method:'POST',headers:{origin:'https://aiya.test','x-forwarded-for':'rate-test'},body:'{}'}));
assert.equal((await POST(new Request('https://aiya.test/api/create-theatre/model-selection',{method:'POST',headers:{origin:'https://aiya.test','x-forwarded-for':'rate-test'},body:'{}'}))).status,429);
console.log('PASS: signing/tampering/expiry, password/origin/mode, secure cookie, selection persistence, no secrets, rate limit');
