  await check('call budget stops repair without inventing upstream calls',async()=>{process.env.AIYA_BUILD_MAX_MODEL_CALLS='1';outputs=[bad,good];try{const{status,payload}=await submit();assert.equal(status,502);assert.equal(calls.length,1);assert.equal(payload.build.budget.calls,1);assert.equal(payload.build.calls.length,1);}finally{delete process.env.AIYA_BUILD_MAX_MODEL_CALLS;}});
