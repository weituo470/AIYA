  await check('repair HTTP failure does not fan out or lose original call trace',async()=>{outputs=[bad];behavior='repair-http-fail';try{const{status,payload}=await submit();assert.equal(status,502);assert.equal(calls.length,2);assert.equal(payload.build.calls.length,2);assert.equal(payload.build.repair.status,'failed');}finally{behavior='normal';}});
  await check('safety failure receives one evidence-directed repair',async()=>{outputs=[good.replace('<script>','<script>window.localStorage.setItem("bad","1");'),good];const{status,payload}=await submit();assert.equal(status,200,payload.error);assert.equal(calls.length,2);assert.equal(payload.build.checks[1].status,'passed');assert(calls[1].prompt.includes('safetyViolations'));});
