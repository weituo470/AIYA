PORT=3335
LOG_LEVEL=info
AIYA_DEV_STATE_DIR=.state/dev-runner
AIYA_DEV_WORK_DIR=.state/dev-runner/workspaces
AIYA_DEV_CODEX_COMMAND=codex
AIYA_DEV_CODEX_MODEL=kimi-k2.7-code
AIYA_DEV_CODEX_TIMEOUT_MS=300000
# Default for AIYA Dev: use the same DeepPraxis model lane already used by create-runner.
# Optional: set to user to inherit the local terminal Codex login/config.
AIYA_DEV_CODEX_AUTH_MODE=deepraxis-responses
AIYA_DEV_CODEX_RESPONSES_BASE_URL=http://127.0.0.1:3334/codex-deepraxis/v1
AIYA_CREATE_CLI_DEEPPRAXIS_API_KEY=
AIYA_CREATE_FAST_DIRECT_HTML_API_KEY=
AIYA_CREATE_FAST_MODEL_API_KEY=
AIYA_CREATE_MODEL_API_KEY=
