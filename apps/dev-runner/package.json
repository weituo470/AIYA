                    "typecheck":  "node ../../scripts/check-js-syntax.mjs src scripts",
                    "smoke:terminal":  "node ./scripts/smoke-terminal.mjs",
                    "smoke:web-terminal":  "node ./scripts/smoke-web-terminal.mjs"
                },
    "dependencies":  {
                         "@fastify/websocket":  "^11.2.0",
                         "fastify":  "^5.2.0",
                         "node-pty":  "^1.1.0"
                     }
}
