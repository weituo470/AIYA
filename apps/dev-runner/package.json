{
    "name":  "@aiya/dev-runner",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "node --env-file=.env ./src/index.js",
                    "start":  "node --env-file=.env ./src/index.js",
                    "build":  "node ../../scripts/check-js-syntax.mjs src scripts",
