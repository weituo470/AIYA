# Web and database
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiya
NEXT_PUBLIC_API_BASE_URL=
ALLOWED_ORIGINS=http://localhost:3333,http://127.0.0.1:3333

# AI teacher / code generation (OpenAI-compatible API)
AIYA_TEACHER_CODER_PROVIDER=openai
AIYA_TEACHER_CODER_BASE_URL=https://api.openai.com/v1
AIYA_TEACHER_CODER_API_KEY=
AIYA_TEACHER_CODER_MODEL=
AIYA_TEACHER_CODER_QUALITY_MODEL=
AIYA_TEACHER_CODER_TIMEOUT_MS=180000
AIYA_TEACHER_CODER_MAX_TOKENS=16000
AIYA_TEACHER_CODER_JSON_MODE=true

# Optional web search
AIYA_TEACHER_CODER_SEARCH_ENABLED=false
AIYA_TEACHER_CODER_SEARCH_PROVIDER=bing
AIYA_TEACHER_CODER_SEARCH_API_KEY=
AIYA_TEACHER_CODER_SEARCH_BASE_URL=https://api.search.brave.com
AIYA_TEACHER_CODER_SEARCH_MAX_RESULTS=4
AIYA_TEACHER_CODER_SEARCH_TIMEOUT_MS=6500

# Admin and encrypted model settings (required in production)
CREATE_THEATRE_ADMIN_TOKEN=
CREATE_THEATRE_MODEL_OPERATION_PASSWORD=
CREATE_THEATRE_SETTINGS_ENCRYPTION_KEY=
CREATE_THEATRE_SETTINGS_FILE=.state/create-theatre-settings.json
AIYA_DIAGNOSTICS_TOKEN=
AIYA_DIAGNOSTICS_DIR=.state/diagnostics

# Teacher speech (optional)
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_STREAM_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_STREAM_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
DOUBAO_TTS_SPEAKER=
AIYA_EDGE_TTS_FALLBACK=false
AIYA_EDGE_TTS_PYTHON=python
AIYA_EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# Optional services
AIYA_CREATE_RUNNER_BASE_URL=http://127.0.0.1:3334
AIYA_DEV_RUNNER_BASE_URL=http://127.0.0.1:3335
NEXT_PUBLIC_AIYA_DEV_RUNNER_WS_URL=ws://127.0.0.1:3335/ws
NEXT_PUBLIC_AIYA_ASR_WS_URL=
